{
  "name": "example-coding",
  "packages": [
    {
      "name": "builder",
      "path": "./agents/builder",
      "entrypoint": "start.sh",
      "args": [
        "{prompt}"
      ]
    },
    {
      "name": "reviewer",
      "path": "./agents/reviewer",
      "entrypoint": "start.sh",
      "args": [
        "{prompt}"
      ]
    }
  ],
  "workflow": {
    "start": "build",
    "stages": [
      {
        "name": "implementation",
        "loop": {
          "mode": "sequential",
          "limit": 3,
          "steps": [
            {
              "name": "build",
              "type": "run",
              "title": "Implement the request",
              "instructions": "Implement the request in the project and report the changes and checks performed.",
              "on": {
                "ready_for_review": "review",
                "failed": "$blocked"
              },
              "budget": {
                "tokens": 2000000,
                "elapsed_seconds": 1800,
                "idle_seconds": 600,
                "warn_percent": 80,
                "action": "pause"
              },
              "package": "builder",
              "input_bindings": {
                "task": {
                  "execution": "input"
                }
              }
            },
            {
              "name": "review",
              "type": "run",
              "title": "Review the implementation",
              "instructions": "Review the work against the request. Return changes_requested with specific findings or completed when it is ready for human acceptance.",
              "on": {
                "changes_requested": "build",
                "completed": "acceptance",
                "failed": "$blocked"
              },
              "package": "reviewer"
            }
          ]
        },
        "human": {
          "required": true,
          "step": "acceptance"
        },
        "hooks": {
          "after": [
            {
              "name": "commit-implementation",
              "command": "python3",
              "arguments": [
                "../registry/scripts/git-commit.py",
                "--type",
                "chore",
                "--scope",
                "implementation",
                "--description",
                "complete implementation stage",
                "--path",
                "."
              ]
            }
          ]
        }
      }
    ],
    "steps": [
      {
        "name": "acceptance",
        "type": "decision",
        "actor": "human",
        "title": "Accept the implementation",
        "on": {
          "approve": "$done",
          "request_changes": "build",
          "reject": "$blocked"
        }
      }
    ]
  },
  "hooks": {
    "before": [
      {
        "name": "work-branch",
        "command": "python3",
        "arguments": [
          "../registry/scripts/git-work-branch.py",
          "--base",
          "HEAD",
          "--prefix",
          "execution/"
        ]
      }
    ],
    "after": [
      {
        "name": "release-checkout",
        "command": "python3",
        "arguments": [
          "../registry/scripts/git-work-branch.py",
          "--release"
        ]
      }
    ]
  }
}
